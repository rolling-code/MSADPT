{
  "schemaVersion": "1.0",
  "policyName": "MSADPT Milestone 2 Read-Only Autonomous Collection",
  "allowedExecutionClasses": ["read_only"],
  "blockedExecutionClasses": ["authenticated_access_test", "credential_operation", "state_change", "exploit"],
  "requireRegisteredModule": true,

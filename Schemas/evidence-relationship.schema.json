{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/msadpt/schemas/evidence-relationship.schema.json",
  "title": "MSADPT Evidence Relationship",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","relationshipId","from","relationshipType","to","status","evidenceReferences","doesNotProve","observedUtc"],
  "properties": {
    "schemaVersion": {"const":"1.0"},
    "relationshipId": {"type":"string","pattern":"^rel-[A-Za-z0-9._-]+$"},
    "from": {"type":"string","minLength":1},
    "relationshipType": {"type":"string","minLength":1},
    "to": {"type":"string","minLength":1},
    "status": {"enum":["Confirmed","Likely or probable","Inconclusive","Not detected","Not applicable"]},
    "evidenceReferences": {"type":"array","minItems":1,"items":{"type":"string"}},
    "doesNotProve": {"type":"array","items":{"type":"string"}},
    "observedUtc": {"type":"string","format":"date-time"}
  }
}
